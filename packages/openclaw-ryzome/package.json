{
	"name": "@ryzome-ai/openclaw-ryzome",
	"version": "0.6.0",
	"description": "Ryzome Canvas OpenClaw Plugin",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xPlaygrounds/ryzome-mcp-plugins.git",
		"directory": "packages/openclaw-ryzome"
	},
	"homepage": "https://github.com/0xPlaygrounds/ryzome-mcp-plugins/tree/main/packages/openclaw-ryzome",
	"bugs": {
		"url": "https://github.com/0xPlaygrounds/ryzome-mcp-plugins/issues"
	},
	"keywords": [
		"openclaw",
		"ryzome",
		"plugin",
		"canvas",
		"agent"
	],
	"openclaw": {
		"extensions": [
			"./dist/index.js"
		],
		"compat": {
			"pluginApi": ">=2026.9.5",
			"minGatewayVersion": "2026.9.5"
		},
		"build": {
			"openclawVersion": "2026.9.5",
			"pluginSdkVersion": "2026.9.5"
		}
	},
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"openclaw.plugin.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint . && tsc --noEmit",
		"lint:check": "biome lint --diagnostic-level=error .",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@sinclair/typebox": "^0.34.52",
		"@types/node": "^24",
		"openclaw": "^2026.9.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@ryzome-ai/ryzome-core": "workspace:*",
		"chalk": "^6.0.0",
		"zod": "^4.6.5"
	}
}
